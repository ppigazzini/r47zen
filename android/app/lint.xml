<?xml version="1.0" encoding="UTF-8"?>
<lint>
    <!--
        Project-wide lint suppressions for the R47 Zen calculator app: only the
        ones whose reason holds for every file. A suppression with a local reason
        sits at its site instead (tools:ignore in XML, @SuppressLint in Kotlin),
        next to the comment that justifies it. Everything else is gated by
        warningsAsErrors with no baseline, so lint must stay clean rather than
        grandfather findings (see app/build.gradle).
    -->

    <!-- Settings-owned screens force English on purpose; the app ships no per-app
         language splits and does not use Play Core locale delivery. -->
    <issue id="AppBundleLocaleChanges" severity="ignore" />

    <!-- AGP and Gradle are pinned deliberately and bumped as an explicit toolchain
         decision, not on every available patch. -->
    <issue id="AndroidGradlePluginVersion" severity="ignore" />

    <!-- Library versions in gradle/libs.versions.toml are pinned deliberately and
         bumped as explicit, reviewed decisions, mirroring AndroidGradlePluginVersion
         above. Both checks below report the same finding: a newer version exists.
         NewerVersionAvailable makes a per-dependency network call to a remote Maven
         repo and is off by default; GradleDependency reads the offline index bundled
         with lint and is on by default, so suppressing only the first leaves the lane
         exposed. Under warningsAsErrors either one turns a green build red whenever a
         dependency publishes a patch, with no change to this repo, making CI
         non-deterministic. Deliberate pins gate bumps: Dependabot proposes them
         and review accepts them. Lint does not. -->
    <issue id="NewerVersionAvailable" severity="ignore" />
    <issue id="GradleDependency" severity="ignore" />
</lint>
