<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- GWP-ASan on every allocation it samples, and a crash on what it finds: the
         debug build and every instrumented run, never a build that ships. -->
    <application
        android:gwpAsanMode="always"
        tools:targetApi="30">
        <activity android:name="io.github.ppigazzini.r47zen.StorageAccessTestActivity" />
        <provider
            android:name="io.github.ppigazzini.r47zen.RecordingDocumentProvider"
            android:authorities="${applicationId}.recording-documents"
            android:exported="false" />
    </application>

</manifest>
